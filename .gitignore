# ============================================================
# Keil / MDK 构建产物与个人配置
# 说明：Output 目录可以随时由 Keil 重新生成，不纳入版本管理，
#       避免每次编译都产生大量二进制差异。
# ============================================================

# 编译输出目录（.axf/.hex/.map/.o/.d 等）
Output/

# Keil 个人界面布局与调试器设置，换电脑会重新生成
*.uvguix.*
*.uvoptx
JLinkSettings.ini

# 编译中间文件
*.o
*.d
*.axf
*.hex
*.map
*.lnp
*.dep
*.crf
*.lst
*.htm

# 编辑器 / 系统临时文件
tmp/
Thumbs.db
desktop.ini

# Python 工具运行缓存
__pycache__/
*.pyc

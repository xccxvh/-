#include "SPI0_OLED/spi0_oled.h"
#include "SPI0_OLED/spi0_oledfont.h"

/*
 * OLED 显示驱动说明：
 * 1. 本文件面向 SSD1306 兼容单色 OLED，底层通过 SPI0 发送命令和显示数据。
 * 2. 工程当前主要用它显示调试字符串、数字以及少量汉字，因此保留了常用的字符、数字、图片接口。
 * 3. 这里对原有代码做了格式整理，并补充了中文注释，方便后续继续扩展显示页面。
 */

/*
 * 对 OLED 模块执行上电后的硬件复位时序。
 * 复位脚由 SysConfig 已经配置为普通 GPIO，这里只负责拉高、拉低并满足最小延时要求。
 */
void OLED_spi0_init(void)
{
    delay_ms(100);
    OLED_RST_Set();
    delay_ms(100);
    OLED_RST_Clr();
    delay_ms(100);
    OLED_RST_Set();
}

/*
 * 向 SSD1306 写入一个字节。
 * cmd 为 0 时表示命令字节，cmd 为 1 时表示显示数据字节。
 */
void OLED_WR_Byte(u8 dat, u8 cmd)
{
    if (cmd)
    {
        OLED_DC_Set();
    }
    else
    {
        OLED_DC_Clr();
    }

    OLED_CS_Clr();
    DL_SPI_transmitData8(SPI_0_INST, dat);
    delay_cycles(30);
    OLED_CS_Set();
    OLED_DC_Set();
}

/*
 * 设置 OLED 当前写入位置。
 * y 按页寻址，范围为 0 到 7；x 按列寻址，范围为 0 到 127。
 */
void OLED_Set_Pos(unsigned char x, unsigned char y)
{
    OLED_WR_Byte(0xB0 + y, OLED_CMD);
    OLED_WR_Byte(((x & 0xF0) >> 4) | 0x10, OLED_CMD);
    OLED_WR_Byte((x & 0x0F) | 0x01, OLED_CMD);
}

/* 打开 OLED 面板显示输出。 */
void OLED_Display_On(void)
{
    OLED_WR_Byte(0x8D, OLED_CMD);
    OLED_WR_Byte(0x14, OLED_CMD);
    OLED_WR_Byte(0xAF, OLED_CMD);
}

/* 关闭 OLED 面板显示输出。 */
void OLED_Display_Off(void)
{
    OLED_WR_Byte(0x8D, OLED_CMD);
    OLED_WR_Byte(0x10, OLED_CMD);
    OLED_WR_Byte(0xAE, OLED_CMD);
}

/*
 * 清空整块 OLED 显示缓存。
 * SSD1306 采用页模式显示，因此需要逐页逐列写入 0。
 */
void OLED_Clear(void)
{
    u8 i;
    u8 n;

    for (i = 0; i < 8; i++)
    {
        OLED_WR_Byte(0xB0 + i, OLED_CMD);
        OLED_WR_Byte(0x02, OLED_CMD);
        OLED_WR_Byte(0x10, OLED_CMD);

        for (n = 0; n < 128; n++)
        {
            OLED_WR_Byte(0, OLED_DATA);
        }
    }
}

/*
 * 在指定位置显示一个 ASCII 字符。
 * y 以页为单位，字号由编译期宏 SIZE 决定，当前工程主要使用 8x16 字体。
 */
void OLED_ShowChar(u8 x, u8 y, u8 chr)
{
    unsigned char c;
    unsigned char i;

    c = chr - ' ';
    if (x > Max_Column - 1)
    {
        x = 0;
        y = y + 2;
    }

    if (SIZE == 16)
    {
        OLED_Set_Pos(x, y);
        for (i = 0; i < 8; i++)
        {
            OLED_WR_Byte(F8X16[c * 16 + i], OLED_DATA);
        }

        OLED_Set_Pos(x, y + 1);
        for (i = 0; i < 8; i++)
        {
            OLED_WR_Byte(F8X16[c * 16 + i + 8], OLED_DATA);
        }
    }
    else
    {
        OLED_Set_Pos(x, y + 1);
        for (i = 0; i < 6; i++)
        {
            OLED_WR_Byte(F6x8[c][i], OLED_DATA);
        }
    }
}

/* 计算 m 的 n 次方，供数字显示时拆位使用。 */
u32 oled_pow(u8 m, u8 n)
{
    u32 result = 1;

    while (n--)
    {
        result *= m;
    }

    return result;
}

/*
 * 在指定位置显示无符号整数。
 * len 表示显示位数，不足部分会以空格填充，便于页面定宽对齐。
 */
void OLED_ShowNum(u8 x, u8 y, u32 num, u8 len, u8 size2)
{
    u8 t;
    u8 temp;
    u8 enshow = 0;

    for (t = 0; t < len; t++)
    {
        temp = (num / oled_pow(10, len - t - 1)) % 10;
        if ((enshow == 0) && (t < (len - 1)))
        {
            if (temp == 0)
            {
                OLED_ShowChar(x + (size2 / 2) * t, y, ' ');
                continue;
            }
            enshow = 1;
        }

        OLED_ShowChar(x + (size2 / 2) * t, y, temp + '0');
    }
}

/*
 * 在指定位置显示字符串。
 * 当前实现每个字符宽度按 8 像素累加，超出一行后会自动换到下一页。
 */
void OLED_ShowString(u8 x, u8 y, u8 *chr)
{
    unsigned char j = 0;

    while (chr[j] != '\0')
    {
        OLED_ShowChar(x, y, chr[j]);
        x += 8;
        if (x > 120)
        {
            x = 0;
            y += 2;
        }
        j++;
    }
}

/*
 * 显示字库中的汉字。
 * no 为字模索引，每个汉字占用 16x16 点阵，因此会连续写两页显示数据。
 */
void OLED_ShowCHinese(u8 x, u8 y, u8 no)
{
    u8 t;

    OLED_Set_Pos(x, y);
    for (t = 0; t < 16; t++)
    {
        OLED_WR_Byte(Hzk[2 * no][t], OLED_DATA);
    }

    OLED_Set_Pos(x, y + 1);
    for (t = 0; t < 16; t++)
    {
        OLED_WR_Byte(Hzk[2 * no + 1][t], OLED_DATA);
    }
}

/*
 * 显示指定区域的 BMP 点阵数据。
 * y0 和 y1 采用页坐标，适合直接显示已经按 SSD1306 页格式组织好的位图数组。
 */
void OLED_DrawBMP(unsigned char x0, unsigned char y0, unsigned char x1, unsigned char y1, unsigned char BMP[])
{
    unsigned int j = 0;
    unsigned char x;
    unsigned char y;

    if ((y1 % 8) == 0)
    {
        y = y1 / 8;
    }
    else
    {
        y = y1 / 8 + 1;
    }

    for (y = y0; y < y1; y++)
    {
        OLED_Set_Pos(x0, y);
        for (x = x0; x < x1; x++)
        {
            OLED_WR_Byte(BMP[j++], OLED_DATA);
        }
    }
}

/*
 * 初始化 SSD1306 OLED。
 * 初始化序列沿用当前屏幕参数配置，完成后会清屏并打开显示。
 */
void OLED_Init(void)
{
    OLED_spi0_init();
    delay_cycles(8000000);

    OLED_WR_Byte(0xAE, OLED_CMD);
    OLED_WR_Byte(0x02, OLED_CMD);
    OLED_WR_Byte(0x10, OLED_CMD);
    OLED_WR_Byte(0x40, OLED_CMD);
    OLED_WR_Byte(0x81, OLED_CMD);
    OLED_WR_Byte(0xCF, OLED_CMD);
    OLED_WR_Byte(0xA1, OLED_CMD);
    OLED_WR_Byte(0xC8, OLED_CMD);
    OLED_WR_Byte(0xA6, OLED_CMD);
    OLED_WR_Byte(0xA8, OLED_CMD);
    OLED_WR_Byte(0x3F, OLED_CMD);
    OLED_WR_Byte(0xD3, OLED_CMD);
    OLED_WR_Byte(0x00, OLED_CMD);
    OLED_WR_Byte(0xD5, OLED_CMD);
    OLED_WR_Byte(0x80, OLED_CMD);
    OLED_WR_Byte(0xD9, OLED_CMD);
    OLED_WR_Byte(0xF1, OLED_CMD);
    OLED_WR_Byte(0xDA, OLED_CMD);
    OLED_WR_Byte(0x12, OLED_CMD);
    OLED_WR_Byte(0xDB, OLED_CMD);
    OLED_WR_Byte(0x40, OLED_CMD);
    OLED_WR_Byte(0x20, OLED_CMD);
    OLED_WR_Byte(0x02, OLED_CMD);
    OLED_WR_Byte(0x8D, OLED_CMD);
    OLED_WR_Byte(0x14, OLED_CMD);
    OLED_WR_Byte(0xA4, OLED_CMD);
    OLED_WR_Byte(0xA6, OLED_CMD);
    OLED_WR_Byte(0xAF, OLED_CMD);

    OLED_Clear();
    OLED_Display_On();
    OLED_Set_Pos(0, 0);
}
